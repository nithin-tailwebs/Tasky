DJANGO_SECRET_KEY=change-me-to-something-random
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_DATABASE=tasky
MYSQL_USER=tasky
MYSQL_PASSWORD=tasky_dev_password
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306

# To let someone on the same Wi-Fi open the app, add this machine's LAN address
# (`ipconfig getifaddr en0`) to DJANGO_ALLOWED_HOSTS above, then recreate the
# container. See ui/README.md — note the dev-server warnings there first.
